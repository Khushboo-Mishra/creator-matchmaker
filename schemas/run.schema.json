{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Locked campaign run audit",
  "type": "object",
  "required": ["run_id", "run_version", "scoring_version", "prompt_version", "code_version", "data_hash", "mode", "campaign", "data_snapshot_at", "weights", "capability_priorities", "default_weights", "default_priorities", "channels", "evaluated", "ranking", "roster", "audit", "validation"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "run_version": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["live", "synthetic-demo"]},
    "data_snapshot_at": {"type": "string", "format": "date-time"},
    "campaign": {
      "type": "object",
      "required": ["product_description", "objective", "specific_goal", "audience", "brand_requirements"],
      "properties": {
        "product_description": {"type": "string", "minLength": 1},
        "specific_goal": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "brand_requirements": {
          "type": "object",
          "required": ["banned_phrases", "raw_tone", "category_exclusions", "competitors"],
          "additionalProperties": false,
          "properties": {
            "banned_phrases": {"type": "array", "items": {"type": "string"}},
            "raw_tone": {"type": "string"},
            "category_exclusions": {"type": "array", "items": {"type": "string"}},
            "competitors": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "weights": {"$ref": "#/$defs/weights"},
    "default_weights": {"$ref": "#/$defs/weights"},
    "capability_priorities": {"$ref": "#/$defs/priorities"},
    "default_priorities": {"$ref": "#/$defs/priorities"},
    "roster": {"type": "array", "maxItems": 4},
    "evaluated": {"type": "array", "maxItems": 20},
    "ranking": {"type": "array", "maxItems": 20},
    "channels": {"type": "array"},
    "audit": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "weights": {
      "type": "object",
      "required": ["audience_relevance", "engagement", "brand_fit", "momentum", "speed_to_activate", "trend_fit"],
      "minProperties": 6, "maxProperties": 6,
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "priorities": {
      "type": "object",
      "required": ["reach", "demonstration", "credibility", "speed"],
      "minProperties": 4, "maxProperties": 4,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
